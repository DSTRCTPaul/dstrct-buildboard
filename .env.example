# Postgres. Local dev uses the docker container `buildboard-pg` on port 5436.
DATABASE_URL="postgresql://bb:bb@localhost:5436/bb?schema=public"

# Password for /admin (hide/restore/delete reactions). Set a real one in production.
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Any long random string.
SESSION_SECRET="changeme-too"
